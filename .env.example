APP_NAME="AANI GEMAS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
STOREFRONT_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Super Admin created by the seeder (2FA is set up on first login)
ADMIN_EMAIL=admin@aanigems.com
ADMIN_PASSWORD=ChangeMe@123
# Admin session idle timeout (minutes)
ADMIN_IDLE_MINUTES=30
ADMIN_2FA_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aanigems
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="care@aanigems.com"
MAIL_FROM_NAME="${APP_NAME}"
# Staff notifications (new paid order, contact message, gold-rate API failing)
MAIL_ADMIN_NOTIFY=admin@aanigems.com

# Stripe (TEST MODE ONLY for now)
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe API version for mobile PaymentSheet ephemeral keys (match the app SDK)
STRIPE_EPHEMERAL_KEY_VERSION=2024-06-20

# Google Sign-In: ID tokens are verified against these client ids
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Rates
GOLD_API_KEY=
FX_API_URL=https://open.er-api.com/v6/latest/EUR

# Sanctum / CORS
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Customer Bearer token lifetime in minutes (default 30 days)
SANCTUM_TOKEN_EXPIRATION=43200

VITE_APP_NAME="${APP_NAME}"
